# mako — DIAD OS notification daemon (copper/obsidian theme).
# Theme tokens mirror /etc/waybar/style.css.

font=Noto Sans 10

background-color=#2E2018A6
text-color=#EADBCF
border-color=#8B5E3C
border-size=2
border-radius=8
padding=10
margin=8
width=360
height=120

max-visible=5
layer=overlay
anchor=top-right

# Actions
default-timeout=5000
ignore-timeout=1
history-length=15

[urgency=low]
background-color=#2E2018A6
border-color=#6F5B4D

[urgency=normal]
background-color=#2E2018A6
border-color=#8B5E3C

[urgency=critical]
background-color=#2E2018A6
border-color=#C87F4A
default-timeout=0
