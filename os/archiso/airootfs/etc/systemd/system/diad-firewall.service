[Unit]
Description=DIAD nftables firewall
After=network-pre.target
Wants=network-pre.target
# P3-S2.4 — skip the unit entirely if nft is missing (never a boot failure).
ConditionPathExists=/usr/sbin/nft

[Service]
Type=simple
ExecStart=-/usr/sbin/nft -f /etc/nftables.conf
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
