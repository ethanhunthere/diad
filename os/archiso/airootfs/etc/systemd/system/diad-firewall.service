[Unit]
Description=DIAD nftables firewall
After=network-pre.target
Wants=network-pre.target
# P3-S2.4 — skip the unit entirely if nft is missing (never a boot failure).
ConditionPathExists=/usr/sbin/nft

[Service]
Type=oneshot
# Leading '-' makes a failure non-fatal — a firewall hiccup must never
# block or fail the boot of the live ISO.
ExecStart=-/usr/sbin/nft -f /etc/nftables.conf
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
