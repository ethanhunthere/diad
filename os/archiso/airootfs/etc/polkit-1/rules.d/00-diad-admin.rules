/* =============================================================================
 * DIAD OS — Universal Polkit Admin & Hardware Rules
 * =============================================================================
 * Grants user 'diad' and group 'wheel' full authorization for NetworkManager,
 * systemd-logind (power/reboot), and UPower without interactive prompts.
 * =============================================================================
 */
polkit.addRule(function(action, subject) {
    if (subject.user === "diad" || (subject.isInGroup && (subject.isInGroup("wheel") || subject.isInGroup("network")))) {
        if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0 ||
            action.id.indexOf("org.freedesktop.login1.") === 0 ||
            action.id.indexOf("org.freedesktop.upower.") === 0 ||
            action.id.indexOf("org.freedesktop.timedate1.") === 0 ||
            action.id.indexOf("org.freedesktop.hostname1.") === 0 ||
            action.id.indexOf("org.freedesktop.locale1.") === 0) {
            return polkit.Result.YES;
        }
    }
});
