# =============================================================================
# DIAD — Sway Window Manager Configuration
# =============================================================================
# This config sets up a minimal Sway environment with exactly two surfaces:
#   1. DIAD AGENT GUI (Brave app window on 127.0.0.1:7860) on workspace 1
#   2. Brave Browser on workspace 2
# =============================================================================

# ---- Daemon ----
# Start gnome-keyring for secret storage
exec gnome-keyring-daemon --start --components=secrets

# ---- Variables ----
set $mod Mod4         # Super key
set $term foot         # Terminal emulator
set $browser brave     # Browser

# ---- Output Configuration ----
# Default: use the first enabled output with preferred mode
output * bg #1a1a2e solid_color

# ---- Input Configuration ----
# Keyboard layout
input * {
    xkb_layout us
    xkb_options ctrl:nocaps
}

# Touchpad
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# ---- Appearance ----
# PROMPT-2 S2.5 — visible titlebars on every window: normal border + frame.
# The brown titlebar carries the "DIAD · <app_id>" title, so every window
# (GUI app-windows, foot/TUI, Telegram, Slack, Brave) has an obvious chrome
# edge — this is what the waybar [–][□][×] buttons control.
default_border normal
default_floating_border normal

# Every window gets a visible titlebar (default_border normal above). The
# title shows the client's REAL title — no global title_format rewrite, so
# every title-based rule below (assign/for_window, window counts, waybar
# buttons) matches what the client actually reports. RBRO-004 WP-03: title
# matching integrity is what stops the boot flood (a rewritten title made
# every DIAD window look identical and unassignable).

# PROMPT-2 S1 — auto-focus at boot (no user click ever needed): the GUI
# app-window (chromium, URL :7860) and any foot window grab focus when they
# map and are pinned to workspace 1. `focus_follows_mouse no` keeps the
# pointer from ever stealing focus from the agent window.
# The GUI title at map time is the URL (127.0.0.1:7860); after the page
# loads it is the document title (DIAD AGENT) — both rules cover the two
# states. The /apps and /launch app-windows must be matched FIRST so the
# generic :7860 rule never pulls them onto workspace 1.
for_window [app_id="chromium" title="*7860/launch*"] move to workspace 3
for_window [app_id="chromium" title="*7860/apps*"] move to workspace 2
for_window [app_id="chromium" title="*7860*"] focus, move to workspace 1
for_window [app_id="foot"] focus, move to workspace 1
focus_follows_mouse no

# Gaps
gaps inner 4
gaps outer 0

# Colors — brown/copper titlebars (DIAD palette), red for urgent.
client.focused          #8b5e3c #8b5e3c #ffffff #8b5e3c #8b5e3c
client.unfocused        #2a2a3e #2a2a3e #888888 #2a2a3e #2a2a3e
client.focused_inactive #333355 #333355 #cccccc #333355 #333355
client.urgent           #e06c75 #e06c75 #ffffff #e06c75 #e06c75

# ---- Workspace Assignment ----
# Workspace 1: DIAD AGENT GUI — Brave app window titled "DIAD AGENT"
# (must precede the plain-Brave rule so the app window lands on ws1).
# Workspace 2: DIAD Apps icon page + plain browser (RBRO-004 WP-04)
# Workspace 3: DIAD Launchpad + chat apps (Telegram/Slack)
#   - Launchpad rule must precede the generic-Brave rules so the app window
#     (opened as `brave --app=http://127.0.0.1:7860/launch`) lands on ws3.
#   - Telegram/Slack are flatpak sandboxes whose app_id/class is stable.
# NOTE (MASTER FIX S5): there is intentionally NO daemon-side window
# management here — the "ws1 max 8 / ws2 max 2 / ws3 max 2 watcher limits"
# and "launchpad auto-close" features from the original design document DO
# NOT EXIST in code. The supervisor only respawns windows when the count is
# zero; it never kills or caps. Do not assume such limits exist.
assign [title="DIAD AGENT"] 1
assign [app_id="foot"] 1
assign [title="DIAD Apps"] 2
assign [title="DIAD Launchpad"] 3
assign [app_id="brave-browser"] 2
assign [app_id="com.brave.Browser"] 2
# The plain browser window opens as "New Tab" (map-time title); the DIAD
# app-windows (GUI/Apps/Launchpad) map with URL titles and are handled by
# the for_window rules above, so a generic chromium assign is deliberately
# absent — it would steal the app-windows at map time (RBRO-004 WP-04).
assign [app_id="chromium" title="New Tab"] 2
assign [app_id="org.telegram.desktop"] 3
assign [app_id="com.slack.Slack"] 3

# ---- Autostart ----
# Launch mako (notification daemon) before anything that may notify.
exec mako

# Launch DIAD: first-run onboarding, hardware/display/network/power setup,
# DIAD daemon, then the DIAD AGENT GUI (workspace 1) + Brave (workspace 2) +
# DIAD Launchpad (workspace 3).
#
# MASTER FIX S4: the supervisor owns waybar — it is NOT started here anymore
# (its 10 s watchdog relaunches it with /etc/waybar/config + style.css, which
# is also what makes `diad-conf-write waybar-mode` take effect).
exec diad-supervisor.sh

# ---- Keybindings ----

# PROMPT-2 S2.4 — window controls (keyboard mirrors the waybar buttons):
#   Super+M        minimize (move to scratchpad)
#   Super+Shift+M  restore (scratchpad show)
#   Super+F        maximize (fullscreen toggle)
#   Super+Shift+Q  close focused window
# Exit Sway moved to Super+Shift+E (sway's default exit binding).
bindsym $mod+m move scratchpad
bindsym $mod+Shift+m scratchpad show
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exit

# Start terminal
bindsym $mod+Return exec $term

# Start browser
bindsym $mod+b exec $browser

# RBRO-004 WP-03 — user relaunch of the DIAD AGENT GUI (the supervisor
# spawns it exactly once at boot; closing it never auto-reopens it, but the
# user can always bring it back with Super+Shift+A).
bindsym $mod+Shift+a exec brave --app=http://127.0.0.1:7860

# Switch workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

# Move containers
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2

# Reload config
bindsym $mod+Shift+c reload

# Kill focused window
bindsym $mod+q kill

# Snap layouts (diad-snap.sh — tested integer-pixel geometry, spec 2.6):
# Super+G tiles the first 2 windows side by side, Super+Shift+G tiles 4
# in a 2x2 grid (portrait outputs stack vertically, handled by the agent).
bindsym $mod+g exec diad-snap.sh 2
bindsym $mod+Shift+g exec diad-snap.sh 4

# Focus navigation
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split layout
bindsym $mod+v split vertical
bindsym $mod+s split horizontal

# Fullscreen
bindsym $mod+f fullscreen

# Floating toggle
bindsym $mod+Shift+space floating toggle

# Screenshot
bindsym $mod+Print exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%s).png

# Lock screen — Super+L (replaces $mod+Ctrl+l). Note: focus-right now lives
# on $mod+Right so Super+L is free for the lock.
bindsym Super+L exec swaylock -f -c 000000

# Laptop media/backlight keys — populated by diad-hardware-setup.sh on
# laptops (desktops keep this file commented out).
include /etc/sway/conf.d/media-keys.conf

# THE LAW F-15: user keybinding remaps written by `diad-conf-write
# keybinding` (via the agent's set_keybinding intent / Settings panel).
# Seeded empty at build time so the include never errors.
include /etc/diad/sway-overrides.conf

# ---- Status Bar (optional — disabled by default) ----
# Uncomment to enable waybar:
# bar {
#     position bottom
#     status_command waybar
#     colors {
#         background #1a1a2e
#         statusline #ffffff
#         separator  #333355
#         focused_workspace  #4a9eff #4a9eff #1a1a2e
#         active_workspace   #333355 #333355 #ffffff
#         inactive_workspace #1a1a2e #1a1a2e #888888
#         urgent_workspace   #ff4444 #ff4444 #1a1a2e
#     }
# }

# ---- Idle Management ----
exec swayidle -w \
    timeout 300 'swaylock -f -c 1a1a2e' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 1a1a2e'
