# =============================================================================
# DIAD — Sway Window Manager Configuration
# =============================================================================
# Strict 3-workspace architecture:
#   - DIAD AGENT (AI Core GUI / TUI)
#   - BROWSER    (Web Browser & Web Apps)
#   - COMMS      (Telegram / Slack / Launchpad)
# =============================================================================

# ---- Daemon & Secret Storage ----
exec gnome-keyring-daemon --start --components=secrets

# ---- Variables ----
set $mod Mod4
set $term foot
set $browser brave
set $ws1 "DIAD AGENT"
set $ws2 "BROWSER"
set $ws3 "COMMS"

# ---- Output & Background (DIAD Agent emblem reveals when windows close) ----
output * bg /usr/share/backgrounds/diad/wallpaper.png fill #0d0e15

# Force all 3 workspaces to bind to all outputs
workspace $ws1 output *
workspace $ws2 output *
workspace $ws3 output *

# ---- Input Configuration ----
input * {
    xkb_layout us
    xkb_options ctrl:nocaps
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# ---- Appearance & Geometry ----
default_border pixel 0
default_floating_border pixel 0
gaps inner 8
gaps outer 8
gaps top 10
smart_gaps off
smart_borders on

# Zero borders across all windows
for_window [class="^.*"] border pixel 0
for_window [app_id="^.*"] border pixel 0
for_window [title="^.*"] border pixel 0

# 2040 Titanium Obsidian & Cyber-Amber Window Accents
client.focused          #f59e0b #151722 #f8fafc #f59e0b #f59e0b
client.unfocused        #232738 #0d0e15 #94a3b8 #232738 #232738
client.focused_inactive #2a2f45 #151722 #cbd5e1 #2a2f45 #2a2f45
client.urgent           #ef4444 #151722 #ffffff #ef4444 #ef4444

focus_follows_mouse no

# ---- Strict Workspace Routing Rules ----

# Workspace 3: Communications & Launchpad
assign [title="^DIAD Launchpad.*$"] $ws3
assign [app_id="org.telegram.desktop"] $ws3
assign [app_id="telegramdesktop"] $ws3
assign [app_id="com.slack.Slack"] $ws3
for_window [app_id="chrome-127\.0\.0\.1__launch-Default"] move to workspace $ws3
for_window [app_id="chrome-.*" title=".*7860/launch.*"] move to workspace $ws3
for_window [app_id="chromium" title="^DIAD Launchpad.*$"] move to workspace $ws3
for_window [title="^.*Telegram.*$"] move to workspace $ws3
for_window [title="^.*Slack.*$"] move to workspace $ws3
for_window [title="^.*web\.telegram\.org.*$"] move to workspace $ws3
for_window [title="^.*app\.slack\.com.*$"] move to workspace $ws3

# Workspace 2: DIAD Apps Hub & Web Browser
assign [title="^DIAD Apps.*$"] $ws2
assign [app_id="brave-browser"] $ws2
assign [app_id="com.brave.Browser"] $ws2
assign [app_id="chromium" title="^New Tab.*$"] $ws2
assign [app_id="epiphany"] $ws2
assign [app_id="org.gnome.Epiphany"] $ws2
for_window [app_id="chrome-127\.0\.0\.1__apps-Default"] move to workspace $ws2
for_window [app_id="chrome-.*" title=".*7860/apps.*"] move to workspace $ws2
for_window [app_id="chromium" title="^DIAD Apps.*$"] move to workspace $ws2
for_window [app_id="chromium" title="^(?!.*DIAD).*$"] move to workspace $ws2

# Workspace 1: DIAD AGENT (GUI & TUI)
assign [title="^DIAD AGENT.*$"] $ws1
assign [title="^DIAD Agent.*$"] $ws1
assign [title="^DIAD Studio.*$"] $ws1
assign [app_id="foot" title="^DIAD AGENT.*$"] $ws1
for_window [app_id="chrome-127\.0\.0\.1__-Default"] focus, move to workspace $ws1
for_window [app_id="chrome-.*" title=".*7860$"] focus, move to workspace $ws1
for_window [app_id="chromium" title="^DIAD AGENT.*$"] focus, move to workspace $ws1
for_window [app_id="foot"] focus, move to workspace $ws1

# ---- Autostart Services ----
exec /usr/local/bin/diad-waybar
exec mako
exec diad-supervisor.sh

# Pre-register and instantiate all 3 persistent workspaces in Sway IPC
exec_always swaymsg "workspace $ws3; workspace $ws2; workspace $ws1"

# ---- Keybindings ----
bindsym $mod+m move scratchpad
bindsym $mod+Shift+m scratchpad show
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+q kill
bindsym $mod+q kill
bindsym $mod+Shift+e exit

# Start terminal
bindsym $mod+Return exec $term

# Smart Workspace Jumpers & App Launchers
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3

bindsym F1 workspace $ws1; exec /usr/local/bin/brave --app=http://127.0.0.1:7860
bindsym F2 workspace $ws2; exec /usr/local/bin/brave --app=http://127.0.0.1:7860/apps
bindsym F3 workspace $ws3; exec /usr/local/bin/brave --app=http://127.0.0.1:7860/launch
bindsym F5 exec /usr/local/bin/brave --app=http://127.0.0.1:7860

# Direct app shortcuts
bindsym $mod+a exec /usr/local/bin/brave --app=http://127.0.0.1:7860
bindsym $mod+b exec /usr/local/bin/brave
bindsym $mod+t exec /usr/local/bin/diad-telegram
bindsym $mod+s exec /usr/local/bin/diad-slack
bindsym $mod+Shift+a exec /usr/local/bin/brave --app=http://127.0.0.1:7860
bindsym $mod+Shift+l exec /usr/local/bin/brave --app=http://127.0.0.1:7860/launch

# Move containers
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3

# Reload config
bindsym $mod+Shift+c reload

# Focus navigation
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+Right focus right
bindsym $mod+Left focus left

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+Right move right

# Split layout
bindsym $mod+v split vertical
bindsym $mod+Shift+v split horizontal

# Floating toggle
bindsym $mod+Shift+space floating toggle

# Screenshot
bindsym $mod+Print exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%s).png

# Lock screen
bindsym Super+L exec swaylock -f -c 0d0e15

# Laptop media/backlight keys & shortcuts
include /etc/sway/conf.d/media-keys.conf
include /etc/diad/sway-overrides.conf

# ---- Idle Management ----
exec swayidle -w \
    timeout 300 'swaylock -f -c 0d0e15' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 0d0e15'

workspace $ws1
