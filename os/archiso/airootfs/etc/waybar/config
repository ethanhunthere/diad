{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 6,
  "margin-bottom": 10,
  "margin-left": 10,
  "margin-right": 10,
  "exclusive": true,
  "spacing": 8,
  "modules-left": ["clock"],
  "modules-center": ["custom/ws-agent", "custom/ws-browser", "custom/ws-comms"],
  "modules-right": ["custom/wifi", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d}",
    "interval": 10
  },
  "custom/ws-agent": {
    "format": "DIAD AGENT",
    "tooltip": "Workspace 1: DIAD Agent (F1)",
    "on-click": "swaymsg workspace 'DIAD AGENT' && (/usr/local/bin/brave --app=http://127.0.0.1:7860 &)",
    "interval": "once"
  },
  "custom/ws-browser": {
    "format": "BROWSER",
    "tooltip": "Workspace 2: Web Browser (F2)",
    "on-click": "swaymsg workspace 'BROWSER' && (/usr/local/bin/brave &)",
    "interval": "once"
  },
  "custom/ws-comms": {
    "format": "COMMS",
    "tooltip": "Workspace 3: Communications & Launchpad (F3)",
    "on-click": "swaymsg workspace 'COMMS' && (/usr/local/bin/brave --app=http://127.0.0.1:7860/launch &)",
    "interval": "once"
  },
  "custom/wifi": {
    "format": "",
    "tooltip": "Wi-Fi Networks",
    "on-click": "/usr/local/bin/diad-wifi.sh",
    "interval": "once"
  },
  "custom/reboot": {
    "format": "",
    "tooltip": "Restart",
    "on-click": "/usr/local/bin/diad-power.sh reboot",
    "interval": "once"
  },
  "custom/power": {
    "format": "",
    "tooltip": "Shutdown",
    "on-click": "/usr/local/bin/diad-power.sh power",
    "interval": "once"
  }
}
