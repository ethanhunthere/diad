{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-bottom": 4,
  "margin-left": 8,
  "margin-right": 8,
  "exclusive": true,
  "spacing": 8,
  "modules-left": ["clock"],
  "modules-center": ["custom/ws-agent", "custom/ws-browser", "custom/ws-comms"],
  "modules-right": ["network", "custom/lock", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip": false,
    "interval": 10
  },
  "custom/ws-agent": {
    "format": "DIAD AGENT",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 1",
    "interval": "once"
  },
  "custom/ws-browser": {
    "format": "BROWSER",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 2",
    "interval": "once"
  },
  "custom/ws-comms": {
    "format": "COMMS",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 3",
    "interval": "once"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "  {essid} ({signalStrength}%)\nIP: {ipaddr}\nFrequency: {frequency} MHz\n\nClick to open Wi-Fi Manager",
    "tooltip-format-disconnected": "  Wi-Fi Disconnected\n\nClick to scan & connect",
    "on-click": "/usr/local/bin/diad-wifi.sh",
    "interval": 2
  },
  "custom/lock": {
    "format": "",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-lock",
    "interval": "once"
  },
  "custom/reboot": {
    "format": "",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-power.sh reboot",
    "interval": "once"
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-power.sh dialog",
    "interval": "once"
  }
}
