{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "modules-left": ["clock"],
  "modules-center": ["sway/workspaces"],
  "modules-right": ["custom/wifi", "custom/reboot", "custom/power"],
  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d %A}",
    "interval": 10
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "persistent_workspaces": {
      "1: DIAD AGENT": [],
      "2: BROWSER": [],
      "3: COMMS": []
    }
  },
  "custom/wifi": {
    "format": " Wi-Fi",
    "tooltip": "Wi-Fi Networks",
    "on-click": "/usr/local/bin/diad-wifi.sh"
  },
  "custom/reboot": {
    "format": " Restart",
    "tooltip": "Restart",
    "on-click": "/usr/local/bin/diad-power.sh reboot"
  },
  "custom/power": {
    "format": " Power",
    "tooltip": "Power & Session",
    "on-click": "/usr/local/bin/diad-power.sh"
  }
}
