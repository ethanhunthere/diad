{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-bottom": 4,
  "margin-left": 8,
  "margin-right": 8,
  "exclusive": true,
  "spacing": 8,
  "modules-left": ["clock"],
  "modules-center": ["custom/ws-agent", "custom/ws-browser", "custom/ws-comms"],
  "modules-right": ["pulseaudio", "network", "custom/lock", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip": false,
    "interval": 10
  },
  "custom/ws-agent": {
    "format": "DIAD AGENT",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 1",
    "interval": "once"
  },
  "custom/ws-browser": {
    "format": "BROWSER",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 2",
    "interval": "once"
  },
  "custom/ws-comms": {
    "format": "COMMS",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 3",
    "interval": "once"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "on-click-right": "/usr/local/bin/diad-power.sh dialog",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\n• Scroll up/down to adjust\n• Click to mute/unmute"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n• Click to manage Wi-Fi",
    "tooltip-format-ethernet": "{ipaddr}",
    "tooltip-format-disconnected": "No network — click to open Wi-Fi manager",
    "on-click": "/usr/local/bin/diad-wifi.sh",
    "interval": 5
  },
  "custom/lock": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Lock Screen",
    "on-click": "/usr/local/bin/diad-lock",
    "interval": "once"
  },
  "custom/reboot": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Restart System",
    "on-click": "/usr/local/bin/diad-power.sh reboot-confirm",
    "interval": "once"
  },
  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "/usr/local/bin/diad-power.sh dialog",
    "interval": "once"
  }
}
