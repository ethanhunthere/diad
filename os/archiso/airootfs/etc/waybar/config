{
  "layer": "top",
  "position": "top",
  "height": 28,
  "exclusive": true,
  "spacing": 4,
  "modules-left": ["clock"],
  "modules-center": ["sway/workspaces"],
  "modules-right": ["custom/wifi", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "interval": 10
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "1: DIAD AGENT": "◈ DIAD AGENT",
      "2: BROWSER": "🌐 BROWSER",
      "3: COMMS": "💬 COMMS",
      "1": "◈ DIAD AGENT",
      "2": "🌐 BROWSER",
      "3": "💬 COMMS"
    },
    "persistent-workspaces": {
      "1: DIAD AGENT": [],
      "2: BROWSER": [],
      "3: COMMS": []
    }
  },
  "custom/wifi": {
    "format": "\uf1eb",
    "tooltip": "Wi-Fi Networks",
    "on-click": "/usr/local/bin/diad-wifi.sh"
  },
  "custom/reboot": {
    "format": "\uf021",
    "tooltip": "Restart",
    "on-click": "/usr/local/bin/diad-power.sh reboot"
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip": "Power & Session",
    "on-click": "/usr/local/bin/diad-power.sh"
  }
}
