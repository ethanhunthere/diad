{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 4,
  "modules-left": ["clock"],
  "modules-center": ["sway/workspaces"],
  "modules-right": ["custom/winmin", "custom/winmax", "custom/winclose", "custom/suspend", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "interval": 10,
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "tooltip": false,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    }
  },
  "custom/suspend": {
    "format": "\uf186",
    "tooltip": "Sleep",
    "on-click": "/usr/local/bin/diad-power.sh suspend"
  },
  "custom/reboot": {
    "format": "\uf021",
    "tooltip": "Restart",
    "on-click": "/usr/local/bin/diad-power.sh reboot"
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip": "Shutdown",
    "on-click": "/usr/local/bin/diad-power.sh power"
  },
  "custom/winmin": {
    "format": "\uf2d1",
    "tooltip": "Minimize",
    "on-click": "/usr/local/bin/diad-windowctl minimize"
  },
  "custom/winmax": {
    "format": "\uf2d0",
    "tooltip": "Maximize",
    "on-click": "/usr/local/bin/diad-windowctl maximize"
  },
  "custom/winclose": {
    "format": "\uf2d3",
    "tooltip": "Close",
    "on-click": "/usr/local/bin/diad-windowctl close"
  }
}
