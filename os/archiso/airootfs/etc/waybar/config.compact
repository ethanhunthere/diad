{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 4,
  "modules-left": ["clock"],
  "modules-center": ["sway/workspaces"],
  "modules-right": ["custom/suspend", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "interval": 10,
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "tooltip": false,
    "persistent-workspaces": {
      "1": [],
      "2": []
    }
  },
  "custom/suspend": {
    "format": "⏾",
    "tooltip": "Sleep",
    "on-click": "/usr/local/bin/diad-power.sh suspend"
  },
  "custom/reboot": {
    "format": "↻",
    "tooltip": "Restart",
    "on-click": "/usr/local/bin/diad-power.sh reboot"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": "Shutdown",
    "on-click": "/usr/local/bin/diad-power.sh power"
  }
}
