{
  "layer": "top",
  "position": "top",
  "height": 24,
  "margin-top": 8,
  "margin-bottom": 8,
  "margin-left": 8,
  "margin-right": 8,
  "exclusive": true,
  "spacing": 6,
  "modules-left": ["clock"],
  "modules-center": ["custom/ws-agent", "custom/ws-browser", "custom/ws-comms"],
  "modules-right": ["custom/wifi", "custom/lock", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip": false,
    "interval": 10
  },
  "custom/ws-agent": {
    "format": "DIAD AGENT",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 1",
    "interval": "once"
  },
  "custom/ws-browser": {
    "format": "BROWSER",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 2",
    "interval": "once"
  },
  "custom/ws-comms": {
    "format": "COMMS",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-workspace.sh 3",
    "interval": "once"
  },
  "custom/wifi": {
    "format": "",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-wifi.sh",
    "interval": "once"
  },
  "custom/lock": {
    "format": "",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-lock",
    "interval": "once"
  },
  "custom/reboot": {
    "format": "",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-power.sh reboot",
    "interval": "once"
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "/usr/local/bin/diad-power.sh dialog",
    "interval": "once"
  }
}
