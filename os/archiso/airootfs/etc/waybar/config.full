{
  "layer": "top",
  "position": "top",
  "height": 36,
  "exclusive": true,
  "spacing": 8,
  "modules-left": ["clock"],
  "modules-center": ["sway/workspaces"],
  "modules-right": ["custom/wifi", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d}",
    "interval": 10
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "DIAD AGENT": ["*"],
      "BROWSER": ["*"],
      "COMMS": ["*"]
    }
  },
  "custom/wifi": {
    "format": "",
    "tooltip": "Wi-Fi Networks",
    "on-click": "/usr/local/bin/diad-wifi.sh",
    "interval": "once"
  },
  "custom/reboot": {
    "format": "",
    "tooltip": "Restart",
    "on-click": "/usr/local/bin/diad-power.sh reboot",
    "interval": "once"
  },
  "custom/power": {
    "format": "",
    "tooltip": "Shutdown",
    "on-click": "/usr/local/bin/diad-power.sh power",
    "interval": "once"
  }
}
