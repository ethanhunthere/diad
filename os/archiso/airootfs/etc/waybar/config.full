{
  "layer": "top",
  "position": "top",
  "height": 36,
  "exclusive": true,
  "spacing": 6,
  "modules-left": ["clock"],
  "modules-center": ["sway/workspaces"],
  "modules-right": ["custom/wifi", "custom/reboot", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "interval": 10
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "tooltip": false,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    }
  },
  "custom/wifi": {
    "format": "\uf1eb",
    "tooltip": "Wi-Fi Networks",
    "on-click": "/usr/local/bin/diad-wifi.sh"
  },
  "custom/reboot": {
    "format": "\uf021",
    "tooltip": "Restart",
    "on-click": "/usr/local/bin/diad-power.sh reboot"
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip": "Shutdown",
    "on-click": "/usr/local/bin/diad-power.sh power"
  }
}
