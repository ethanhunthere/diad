#!/usr/bin/env bash
# =============================================================================
# DIAD — Universal Lightweight Browser Launcher (2040 Edition)
# =============================================================================
set -uo pipefail

target_url=""
is_app_window=false

while [ $# -gt 0 ]; do
    case "$1" in
        --app=*)
            is_app_window=true
            target_url="${1#--app=}"
            shift
            ;;
        --app)
            is_app_window=true
            if [ $# -gt 1 ] && [[ "$2" =~ ^https?:// ]]; then
                target_url="$2"
                shift 2
            else
                shift
            fi
            ;;
        http://*|https://*)
            target_url="$1"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

if [ -z "$target_url" ]; then
    target_url="https://duckduckgo.com"
fi

# 1. Epiphany (GNOME WebKitGTK — ultra-lightweight Wayland engine)
if command -v epiphany >/dev/null 2>&1; then
    exec /usr/bin/epiphany --new-window "${target_url}"
fi

# 2. Chromium (Fallback)
if command -v chromium >/dev/null 2>&1; then
    WAYLAND_FLAGS="--ozone-platform-hint=auto --ozone-platform=wayland --enable-features=UseOzonePlatform,WaylandWindowDecorations"
    if [ "$(id -u)" = "0" ]; then
        WAYLAND_FLAGS="$WAYLAND_FLAGS --no-sandbox"
    fi
    if [ "$is_app_window" = true ]; then
        exec /usr/bin/chromium $WAYLAND_FLAGS --app="${target_url}"
    else
        exec /usr/bin/chromium $WAYLAND_FLAGS "${target_url}"
    fi
fi

# 3. Brave Flatpak (if installed)
if command -v flatpak >/dev/null 2>&1 && flatpak list --app --columns=application 2>/dev/null | grep -qx 'com.brave.Browser'; then
    if [ "$is_app_window" = true ]; then
        exec /usr/bin/flatpak run com.brave.Browser --app="${target_url}"
    else
        exec /usr/bin/flatpak run com.brave.Browser "${target_url}"
    fi
fi

notify-send "DIAD" "No browser available" -u critical 2>/dev/null || true
exit 1
