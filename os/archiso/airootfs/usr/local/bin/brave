#!/usr/bin/env bash
# =============================================================================
# DIAD — Universal Browser Launcher Shim (Multi-Instance Isolated)
# =============================================================================
set -uo pipefail

HOME_DIR="${HOME:-/home/diad}"
DATA_DIR="${HOME_DIR}/.config/chromium-default"

for a in "$@"; do
    case "$a" in
        *7860/apps*|*workspace/2*|*duckduckgo*|*google*|*bing*|http*|https*)
            DATA_DIR="${HOME_DIR}/.config/diad-browser"
            ;;
        *7860/launch*|*workspace/3*|*telegram*|*slack*)
            DATA_DIR="${HOME_DIR}/.config/diad-comms"
            ;;
        *lockscreen*|*lock*)
            DATA_DIR="/tmp/diad-lock-profile"
            ;;
        *7860*)
            DATA_DIR="${HOME_DIR}/.config/diad-agent"
            ;;
    esac
done

mkdir -p "${DATA_DIR}/Default"
PREFS_FILE="${DATA_DIR}/Default/Preferences"
LOCAL_STATE="${DATA_DIR}/Local State"

if [ ! -f "${PREFS_FILE}" ]; then
    echo '{"browser":{"custom_chrome_frame":true}}' > "${PREFS_FILE}"
elif ! grep -q '"custom_chrome_frame"' "${PREFS_FILE}" 2>/dev/null; then
    if command -v jq >/dev/null 2>&1; then
        jq '.browser.custom_chrome_frame = true' "${PREFS_FILE}" > "${PREFS_FILE}.tmp" 2>/dev/null && mv "${PREFS_FILE}.tmp" "${PREFS_FILE}" || true
    fi
fi

if [ ! -f "${LOCAL_STATE}" ]; then
    echo '{"browser":{"custom_chrome_frame":true}}' > "${LOCAL_STATE}"
fi

# Wayland & GPU acceleration flags for Chromium
WAYLAND_FLAGS="--ozone-platform-hint=auto --ozone-platform=wayland --enable-features=UseOzonePlatform,WaylandWindowDecorations --enable-gpu-rasterization --enable-zero-copy --ignore-gpu-blocklist --user-data-dir=${DATA_DIR}"
if [ "$(id -u)" = "0" ]; then
    WAYLAND_FLAGS="${WAYLAND_FLAGS} --no-sandbox"
fi

# Ultra-lightweight & Speed flags (cuts renderer memory by ~40% and disables background noise)
APP_FLAGS="--default-background-color=0xff090a0f --background-color=0xff090a0f --no-first-run --no-default-browser-check --disable-sync --disable-background-networking --disable-component-update --disable-features=Translate,MediaRouter,OptimizationHints,Feed --metrics-recording-only --disable-breakpad --process-per-site --enable-low-end-device-mode --disable-domain-reliability"

# 1. Chromium (built into the ISO)
if command -v chromium >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec /usr/bin/chromium ${WAYLAND_FLAGS} $APP_FLAGS "$@"
fi

# 2. Flatpak Brave (if user installed it via first-run wizard)
if command -v flatpak >/dev/null 2>&1 \
    && flatpak list --app --columns=application 2>/dev/null | grep -qx 'com.brave.Browser'; then
    # shellcheck disable=SC2086
    exec /usr/bin/flatpak run com.brave.Browser $APP_FLAGS "$@"
fi

# 3. Epiphany (Fallback if installed)
if command -v epiphany >/dev/null 2>&1; then
    exec /usr/bin/epiphany "$@"
fi

notify-send "DIAD" "No browser available" -u critical 2>/dev/null || true
exit 1
