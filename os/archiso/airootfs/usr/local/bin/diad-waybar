#!/usr/bin/env bash
# =============================================================================
# DIAD — Waybar Launch Wrapper
# =============================================================================
set -uo pipefail

# Ensure single instance and no error bars
pkill -9 -f swaynag 2>/dev/null || true
pkill -x waybar 2>/dev/null || true
sleep 0.05

exec /usr/bin/waybar -c /etc/waybar/config -s /etc/waybar/style.css
