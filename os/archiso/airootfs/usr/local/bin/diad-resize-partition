#!/usr/bin/env bash
# =============================================================================
# DIAD least-privilege wrapper: grow a partition to the end of its device
# (audit F-12 / phase A1 / R-3). Replaces a raw `parted` sudoers entry.
# -----------------------------------------------------------------------------
# Usage: sudo diad-resize-partition [--confirm=resize-partition] DEVICE PARTNUM
#
set -u

DEV_RE='^/dev/[a-z0-9/_-]+$'
PART_RE='^[1-9][0-9]*$'

fail() {
    echo "diad-resize-partition: $*" >&2
    exit 2
}

if [[ "${1:-}" == "--confirm=resize-partition" ]]; then
    shift
elif [[ "${DIAD_CONFIRM:-}" != "resize-partition" ]]; then
    fail "missing --confirm=resize-partition flag"
fi

[[ $# -eq 2 ]] || fail "usage: diad-resize-partition [--confirm=resize-partition] DEVICE PARTNUM"
[[ "$1" =~ $DEV_RE ]] || fail "invalid device: $1"
[[ "$2" =~ $PART_RE ]] || fail "invalid partition number: $2"

exec parted -s "$1" resizepart "$2" 100%
