#!/usr/bin/env bash
# =============================================================================
# DIAD least-privilege wrapper: install a user-generated config file into a
# FIXED allowlisted root-owned destination (audit F-12 / phase A1).
# -----------------------------------------------------------------------------
# Replaces every `sudo sed -i` / `sudo tee` on system files: scripts now
# generate the file in user space (no privilege needed) and hand it over.
#
# Usage: sudo diad-install-conf SRC DST
#
set -u

fail() {
    echo "diad-install-conf: $*" >&2
    exit 2
}

[[ $# -eq 2 ]] || fail "usage: diad-install-conf SRC DST"

# Source must live in the INVOKING user's ~/.diad — derived dynamically so a
# renamed account (first-boot identity setup) keeps working.
CALLER="${SUDO_USER:-}"
if [[ -z "${CALLER}" || "${CALLER}" == "root" ]]; then
    fail "no invoking user (SUDO_USER)"
fi
CALLER_HOME="$(getent passwd "${CALLER}" | cut -d: -f6)"
if [[ -z "${CALLER_HOME}" ]]; then
    fail "cannot resolve home for '${CALLER}'"
fi

[[ "$1" =~ ^[A-Za-z0-9._/-]+$ ]] || fail "invalid source path: $1"
real_src="$(realpath -m -- "$1" 2>/dev/null)" || fail "cannot resolve source"
case "${real_src}" in
    "${CALLER_HOME}/.diad/"*|"/home/diad/.diad/"*) : ;;
    *) fail "source must live in ${CALLER_HOME}/.diad" ;;
esac
[[ -f "${real_src}" ]] || fail "source does not exist: ${real_src}"

case "$2" in
    /etc/systemd/logind.conf.d/diad.conf) : ;;
    /etc/sway/conf.d/media-keys.conf) : ;;
    /etc/sway/conf.d/diad-overrides.conf) : ;;
    /etc/waybar/config) : ;;
    /etc/diad/sway-overrides.conf) : ;;
    /etc/diad/perf-tier) : ;;
    *) fail "destination not allowlisted: $2" ;;
esac

mkdir -p "$(dirname "$2")"
exec install -m 644 -o root -g root "${real_src}" "$2"
