#!/usr/bin/env sh
# =============================================================================
# DIAD — app launcher for icon pages and TUI
# =============================================================================
set -u

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

app="${1:-}"
case "${app}" in
    browser)
        win_id="$(swaymsg -t get_tree 2>/dev/null | jq -r '.. | objects |
            select(.type? == "con"
               and ((.app_id? // "") | test("epiphany|org.gnome.Epiphany|brave|chromium"))
               and (((.name? // "") | test("DIAD AGENT|DIAD Apps|DIAD Launchpad")) | not))
            | .id' 2>/dev/null | head -n 1)"
        if [ -n "${win_id}" ]; then
            swaymsg "[con_id=${win_id}] focus" >/dev/null 2>&1
            swaymsg workspace 2 >/dev/null 2>&1
            exit 0
        fi
        swaymsg workspace 2 >/dev/null 2>&1
        swaymsg '[title="DIAD Apps"] kill' >/dev/null 2>&1 || true
        brave "http://127.0.0.1:7860/apps" >/dev/null 2>&1 &
        exit 0
        ;;
    telegram)
        exec /usr/local/bin/diad-telegram
        ;;
    slack)
        exec /usr/local/bin/diad-slack
        ;;
    *)
        notify-send "diad-open: unknown app '${app}'" -u critical 2>/dev/null || true
        exit 1
        ;;
esac
