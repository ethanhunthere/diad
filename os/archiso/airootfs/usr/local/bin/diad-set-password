#!/usr/bin/env bash
# =============================================================================
# DIAD — set the login password for the diad user (root wrapper).
# =============================================================================
# MASTER FIX S2 — the ONLY sudo path that can change the login password.
# The sudoers grant is argv-pinned to this wrapper (no shell, no passwd, no
# sed): privilege escalation with a fixed, validated purpose.
#
# Input: one line of `USER:PASSWORD` on stdin (never argv — argv would leak
# the password into the process list).
#   - USER must be exactly `diad` (never root, never arbitrary).
#   - PASSWORD must be at least 8 characters.
# The validated pair is piped to chpasswd, which hashes and installs it.
#
# Called from the DIAD AGENT daemon (running as diad) via:
#   printf 'diad:%s\n' "$NEW" | sudo /usr/local/bin/diad-set-password
# =============================================================================

set -uo pipefail

IFS= read -r line || { echo "diad-set-password: no input on stdin" >&2; exit 1; }

user="${line%%:*}"
pass="${line#*:}"

# Refuse anything but the DIAD user.
if [[ "${user}" != "diad" ]]; then
    echo "diad-set-password: refusing user '${user}'" >&2
    exit 1
fi

# Mandatory minimum length (wizard also enforces it, this is the backstop).
if [[ ${#pass} -lt 8 ]]; then
    echo "diad-set-password: password must be at least 8 characters" >&2
    exit 1
fi

printf '%s:%s\n' "${user}" "${pass}" | /usr/sbin/chpasswd
