#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Pictures"
if command -v slurp >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    GEOM=$(slurp 2>/dev/null || true)
    if [ -n "$GEOM" ]; then
        grim -g "$GEOM" "$HOME/Pictures/screenshot-$(date +%s).png"
        notify-send "Screenshot" "Saved selection to ~/Pictures" -i camera-photo
        exit 0
    fi
fi
grim "$HOME/Pictures/screenshot-$(date +%s).png"
notify-send "Screenshot" "Saved full screen to ~/Pictures" -i camera-photo
