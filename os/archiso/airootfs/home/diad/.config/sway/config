# =============================================================================
# DIAD — Sway Window Manager Configuration
# =============================================================================
# Strict 3-workspace architecture:
#   - DIAD AGENT (AI Core GUI / TUI)
#   - BROWSER    (Web Browser & Web Apps)
#   - COMMS      (Telegram / Slack / Launchpad)
# =============================================================================

swaynag_command /bin/true
xwayland disable

# ---- Daemon & Secret Storage ----
exec gnome-keyring-daemon --start --components=secrets

# ---- Variables ----
set $mod Mod4
set $term foot
set $browser brave
set $ws1 "DIAD AGENT"
set $ws2 "BROWSER"
set $ws3 "COMMS"

# ---- Output & Background ----
output * bg /usr/share/backgrounds/diad/wallpaper.png fill #090A0A

# Workspace layout
workspace_layout default

# ---- Input Configuration ----
input * {
    xkb_layout "us"
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# ---- Appearance & Geometry ----
font pango:Inter 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 0
gaps top 8
gaps bottom 0
gaps left 0
gaps right 0
smart_gaps off
smart_borders off

# High-Contrast Industrial Basalt & Luminous Crimson Tokens (Focused #FF2E4D, Inactive #333C37)
client.focused          #FF2E4D #161918 #FFFFFF #FF2E4D #FF2E4D
client.unfocused        #333C37 #0F1110 #CBD8D2 #333C37 #333C37
client.focused_inactive #333C37 #0F1110 #CBD8D2 #333C37 #333C37
client.urgent           #FF1744 #161918 #FFFFFF #FF1744 #FF1744

focus_follows_mouse no

# Window Dragging & Resizing Everywhere (Borders, Edges, Corners, Mod+Mouse)
tiling_drag enabled
tiling_drag_threshold 5
bindsym --border BTN_RIGHT resize
bindsym --border BTN_LEFT resize
bindsym --whole-window $mod+BTN_RIGHT resize
bindsym --whole-window $mod+BTN_LEFT move
floating_modifier $mod normal

# ---- Strict Workspace Routing Rules ----

# App ID assignments (Valid criteria for assign)
assign [app_id="^foot$"] workspace $ws1
assign [app_id="^chrome-127\.0\.0\.1__-Default$"] workspace $ws1
assign [app_id="^chromium$"] workspace $ws2
assign [app_id="^brave-browser$"] workspace $ws2
assign [app_id="^com\.brave\.Browser$"] workspace $ws2
assign [app_id="^epiphany$"] workspace $ws2
assign [app_id="^org\.gnome\.Epiphany$"] workspace $ws2
assign [app_id="^chrome-127\.0\.0\.1__apps-Default$"] workspace $ws2
assign [app_id="^org\.telegram\.desktop$"] workspace $ws3
assign [app_id="^telegramdesktop$"] workspace $ws3
assign [app_id="^com\.slack\.Slack$"] workspace $ws3
assign [app_id="^chrome-127\.0\.0\.1__launch-Default$"] workspace $ws3

# Title-based dynamic window routing (Must use for_window)
for_window [title="^DIAD AGENT.*$"] move container to workspace $ws1
for_window [title="^DIAD Agent.*$"] move container to workspace $ws1
for_window [title="^DIAD Studio.*$"] move container to workspace $ws1
for_window [title=".*BROWSER.*"] move container to workspace $ws2
for_window [title=".*Workspace 2.*"] move container to workspace $ws2
for_window [title="^DIAD Launchpad.*$"] move container to workspace $ws3
for_window [title=".*COMMS.*"] move container to workspace $ws3
for_window [title=".*Workspace 3.*"] move container to workspace $ws3
for_window [title="^.*Telegram.*$"] move container to workspace $ws3
for_window [title="^.*Slack.*$"] move container to workspace $ws3
for_window [title="^.*web\.telegram\.org.*$"] move container to workspace $ws3
for_window [title="^.*app\.slack\.com.*$"] move container to workspace $ws3

for_window [title=".*Locked.*"] fullscreen enable
for_window [title=".*Locked.*"] floating enable

# ---- Autostart Services ----
exec mako
exec /usr/local/bin/diad-waybar
exec /usr/local/bin/diad-supervisor.sh

# ---- Mouse & Desktop Bindings ----
# Right-click context menu on desktop background / root window
bindsym --whole-window BTN_RIGHT exec /usr/local/bin/diad-context-menu.sh
bindsym $mod+BTN_RIGHT exec /usr/local/bin/diad-context-menu.sh
bindsym $mod+m exec /usr/local/bin/diad-context-menu.sh

# Drag floating windows by holding down $mod and left mouse button
floating_modifier $mod normal

# =============================================================================
# DIAD OS — Universal Linux Pro Keyboard Shortcuts (40+ Keybindings)
# =============================================================================

# ---- Core Window Operations ----
bindsym $mod+q kill
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+e exit
bindsym $mod+Shift+c reload

# ---- Launchers & Core Applications ----
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec foot --app-id=floating-terminal
bindsym $mod+d exec wofi --show drun $WOFI_BASE
bindsym $mod+space exec wofi --show drun $WOFI_BASE
bindsym $mod+v exec /usr/local/bin/diad-clipboard.sh
bindsym $mod+n exec /usr/local/bin/diad-wifi.sh
bindsym $mod+p exec /usr/local/bin/diad-power.sh
bindsym $mod+k exec /usr/local/bin/diad-shortcuts.sh

# ---- Direct Workspace Navigation & Fast Switch ----
bindsym F1 workspace $ws1
bindsym F2 workspace $ws2
bindsym F3 workspace $ws3
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9

# Direct app shortcuts matching workspaces
bindsym $mod+a workspace $ws1
bindsym $mod+w workspace $ws2
bindsym $mod+c workspace $ws3
bindsym $mod+b exec /usr/local/bin/brave
bindsym $mod+t exec /usr/local/bin/diad-telegram
bindsym $mod+Shift+s exec /usr/local/bin/diad-slack

# ---- Move Containers to Workspaces ----
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9

# ---- Focus Navigation (Vim + Arrows) ----
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ---- Move Focused Window (Vim + Arrows) ----
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ---- Layout & Tiling Controls ----
bindsym $mod+e layout toggle split
bindsym $mod+s layout stacking
bindsym $mod+Tab layout tabbed
bindsym $mod+backslash split vertical
bindsym $mod+minus split horizontal

# ---- Scratchpad Controls ----
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+grave scratchpad show
bindsym $mod+Shift+grave scratchpad show

# ---- Screenshots (Grim + Slurp) ----
bindsym Print exec grim -g "$(slurp)" - | wl-copy && notify-send "DIAD Screenshot" "Selected area copied to clipboard" -i camera-photo
bindsym Shift+Print exec mkdir -p ~/Pictures/Screenshots && ts=$(date +%Y-%m-%d_%H-%M-%S) && grim ~/Pictures/Screenshots/screenshot_${ts}.png && wl-copy < ~/Pictures/Screenshots/screenshot_${ts}.png && notify-send "DIAD Screenshot" "Saved to Pictures/Screenshots" -i camera-photo
bindsym $mod+Print exec /usr/local/bin/diad-screenshot

# ---- Lock Screen & Power Management ----
bindsym $mod+Shift+p exec /usr/local/bin/diad-lock
bindsym $mod+Escape exec /usr/local/bin/diad-lock
bindsym XF86ScreenSaver exec /usr/local/bin/diad-lock
bindsym Control+Mod1+l exec /usr/local/bin/diad-lock

# ---- Hardware Control (Audio, Brightness, RFKill) ----
# moved to conf.d/media-keys.conf
# bindsym XF86MonBrightnessUp exec brightnessctl set +5%
# moved to conf.d/media-keys.conf
# bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym $mod+F6 exec brightnessctl set +5%
bindsym $mod+F5 exec brightnessctl set 5%-

# moved to conf.d/media-keys.conf
# bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
# moved to conf.d/media-keys.conf
# bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
# moved to conf.d/media-keys.conf
# bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
# moved to conf.d/media-keys.conf
# bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym $mod+F12 exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym $mod+F11 exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym $mod+F10 exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# moved to conf.d/media-keys.conf
# bindsym XF86AudioPlay exec playerctl play-pause
# moved to conf.d/media-keys.conf
# bindsym XF86AudioNext exec playerctl next
# moved to conf.d/media-keys.conf
# bindsym XF86AudioPrev exec playerctl previous
# moved to conf.d/media-keys.conf
# bindsym XF86AudioStop exec playerctl stop
bindsym XF86RFKill exec /usr/local/bin/diad-rfkill

# ---- Interactive Resize Mode ----
mode "resize" {
    bindsym Left resize shrink width 10px
    bindsym Right resize grow width 10px
    bindsym Up resize shrink height 10px
    bindsym Down resize grow height 10px
    bindsym h resize shrink width 10px
    bindsym l resize grow width 10px
    bindsym k resize shrink height 10px
    bindsym j resize grow height 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Overrides
include /etc/diad/sway-overrides.conf

# Laptop media-keys (enabled/disabled at first boot by diad-hardware-setup.sh)
include /etc/sway/conf.d/media-keys.conf

# ---- Idle Management ----
exec swayidle -w \
    timeout 300 '/usr/local/bin/diad-lock' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep '/usr/local/bin/diad-lock'
