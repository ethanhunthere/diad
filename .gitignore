# === Rust ===
target/
**/*.rs.bk
*.swp
*.swo
*~

# === Node / frontend ===
node_modules/
dist/
# Stale build dirs left behind by a root-owned install (can't be deleted as
# the unprivileged user; they are build artifacts only). Covers both the
# `dist-root-stale/` (hyphen) and `*.root-stale/` (dot) naming variants.
*root-stale/
*.tsbuildinfo

# === Environment ===
.env
.env.*
*.env

# === IDE ===
.idea/
.vscode/
*.sublime-*
.DS_Store

# === Build artifacts ===
*.iso
work/
out/
build/

# === OS artifacts ===
*.img
*.qcow2
*.vdi
*.vmdk

# === Diad runtime ===
~/.diad/logs/
~/.diad/sessions/

# === ISO staging (regenerated by `make iso`) ===
os/archiso/airootfs/usr/local/bin/diad-agent
os/archiso/airootfs/usr/local/bin/diad-lock-auth
# Web lockscreen bundle (built from os/lockscreen by `make iso`)
os/archiso/airootfs/usr/share/diad/lockscreen/dist/

# === Keyring ===
*.key
*.pem
*.cert

# === Python ===
__pycache__/
*.pyc

# === Misc ===
*.log
*.tmp
*.old/
*.fd
*-baseline*.txt
.matrix/*.ppm
.matrix/*.sock
# QEMU test-matrix generated outputs (screenshots, error captures, checksums)
# — regenerated by .matrix/matrix.py / qwen-vmtest.py on every run.
.matrix/*.err
.matrix/*.png
.matrix/*.sha256
.matrix/*.qcow2
# Core dumps at the repo ROOT only — a bare `core` pattern would also match
# the agent/src/core/ module directory and silently untrack new sources
# (phase A2 caught daemon.rs/idle.rs/perf.rs already missing).
/core
/core.*
.core
